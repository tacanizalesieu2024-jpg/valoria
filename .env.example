# Copy this file to ".env" and fill in your own key. NEVER commit .env to GitHub.

# Default: Google Gemini (free tier). Get a key at aistudio.google.com -> Get API key
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# To use OpenAI instead (paid): paste an OpenAI key above, empty LLM_BASE_URL=,
# and set LLM_MODEL=gpt-4o-mini

# Multiply 2018 prices to bring them to today (1.0 = no adjustment). Cite the source!
MARKET_ADJUSTMENT=1.0
